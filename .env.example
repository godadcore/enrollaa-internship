# Enrollaa Internship Management System — Environment Configuration
# Authoritative Timezone: Africa/Lagos (WAT, UTC+1)
# Production Domain: enrollaa.com.ng
#
# Never commit real secrets. Do not prefix server secrets with NEXT_PUBLIC_.

# Server-only public origin used to build invitation, activation, and recovery links.
# Local development falls back to http://localhost:3000 when APP_URL is unset.
# Production must set https://enrollaa.com.ng (or the approved public origin).
# Localhost values are rejected in production.
APP_URL=https://enrollaa.com.ng
NEXT_PUBLIC_TIMEZONE=Africa/Lagos

# Supabase (Database, Auth, Storage)
# NEXT_PUBLIC_* values are the project URL and the publishable (anon) key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only. Never expose this in the browser bundle.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional additional key for onboarding bank-detail encryption. If unset, the
# server secret key is used. Server-only.
ONBOARDING_BANK_KEY=

# Resend (invitations, password setup, password recovery)
# Production requires a live key and a verified sending domain.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Enrollaa Internship <internship@enrollaa.com.ng>"

# Local and CI tests only. Must be unset in production or invitation email will not send.
# SKIP_EMAIL_DISPATCH=1

# Optional Slack join URL shown in onboarding copy (not a secret).
SLACK_INVITE_URL=

# Private server-only malware scanner. The scanner must be an authenticated
# HTTPS service that accepts the file bytes and returns JSON {"verdict":"clean"}
# or {"verdict":"infected"}. Leave unset until that service is deployed and
# verified; uploads then fail closed and remain unavailable.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=10000
